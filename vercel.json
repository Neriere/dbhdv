{
  "outputDirectory": "dist",
  "buildCommand": "vite build",
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/api/health"
    },
    {
      "source": "/api/market/download-items-db",
      "destination": "/api/market/items-dictionary"
    },
    {
      "source": "/api/market/batch-update",
      "destination": "/api/market/update"
    },
    {
      "source": "/api/local-db/:path*",
      "destination": "/api/local-db?path=:path*"
    },
    {
      "source": "/api/dofocus/:path*",
      "destination": "/api/dofocus?path=:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}
